# Security headers (2026-07-23 audit): the directory UI renders relay-sourced
# strings client-side — CSP is the defense-in-depth backstop behind esc().
# connect-src allows self + the Nostr relays the browser module queries.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self' https://bitcoineconomy.ai https://cloudflareinsights.com wss://nos.lol wss://relay.primal.net wss://relay.damus.io wss://nostr.bitcoiner.social; frame-ancestors 'none'; base-uri 'self'; object-src 'none'; form-action 'self'

# Agent-readable routes are fetched cross-origin by tools and crawlers.
# Four routes were missing from this list until 2026-08-07 and served no CORS header
# while every sibling did: /master.json, /agents.txt, /l402index.json, /l402space.json.
# They are not obscure — llms.txt names /master.json as the static fallback for the
# route it heads "Start here: one fetch", and the two l402 files as the tier fallbacks.
# So a browser-resident agent following the documented cold-KV path was blocked by
# CORS, which is the exact failure the fallbacks exist to prevent.
/master.json
  Access-Control-Allow-Origin: *
/master-version.json
  Access-Control-Allow-Origin: *
/agents.txt
  Access-Control-Allow-Origin: *
/l402index.json
  Access-Control-Allow-Origin: *
/l402space.json
  Access-Control-Allow-Origin: *
/directory.json
  Access-Control-Allow-Origin: *
/tools.json
  Access-Control-Allow-Origin: *
/snapshot.json
  Access-Control-Allow-Origin: *
/models.json
  Access-Control-Allow-Origin: *
/llms.txt
  Access-Control-Allow-Origin: *
/entries/*
  Access-Control-Allow-Origin: *
/openapi.json
  Access-Control-Allow-Origin: *
/.well-known/ai-plugin.json
  Access-Control-Allow-Origin: *
/spec/*
  Access-Control-Allow-Origin: *
/uptime.json
  Access-Control-Allow-Origin: *
/anchors/*
  Access-Control-Allow-Origin: *
