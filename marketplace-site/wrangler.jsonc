{
  // marketplace.bitcoineconomy.ai — Worker with static assets + cron snapshot.
  // Mirrors the main site's architecture (worker in front, assets behind).
  // One-time setup steps (KV namespace id below, custom domain): see README.md.
  "name": "bitcoineconomy-marketplace",
  "compatibility_date": "2026-06-01",
  "main": "worker.js",
  "assets": {
    "directory": ".",
    "binding": "ASSETS"
  },
  "triggers": {
    // Refresh the live snapshot every 6 hours.
    "crons": ["17 */6 * * *"]
  },
  // Zone route: the Worker intercepts the hostname at the edge and serves the
  // static assets + the /live/* KV routes. This is the ONLY thing serving
  // marketplace.bitcoineconomy.ai — the Pages project this once shadowed was
  // deleted 2026-08-05.
  //
  // DNS for the hostname is a proxied A record → 192.0.2.1 (a black-hole IP,
  // Cloudflare's documented pattern for a Worker-route-only hostname). The route
  // fires before the origin is contacted, so the target is never reached; the
  // record exists only so the hostname resolves to Cloudflare. Deleting that
  // record takes the site down even though this Worker is fine.
  "routes": [
    { "pattern": "marketplace.bitcoineconomy.ai/*", "zone_name": "bitcoineconomy.ai" }
  ],
  "kv_namespaces": [
    {
      "binding": "SNAPSHOT",
      // Created 2026-06-10 via `npx wrangler kv namespace create SNAPSHOT`.
      "id": "a90b31e53761424bbb595508ebf94943"
    }
  ]
}
