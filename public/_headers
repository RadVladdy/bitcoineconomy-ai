# Security headers (2026-07-23 audit): static content + inline JS only, so CSP
# allows 'unsafe-inline' scripts/styles but pins sources to self + Google Fonts.
# The site must never be framed and never sniffed into a different type.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self' https://marketplace.bitcoineconomy.ai https://cloudflareinsights.com; frame-ancestors 'none'; base-uri 'self'; object-src 'none'; form-action 'self'

# NIP-05 verification endpoint: CORS is REQUIRED by the spec (clients fetch
# cross-origin from web apps), and the endpoint must never redirect.
/.well-known/nostr.json
  Access-Control-Allow-Origin: *

# Agent-readable routes are fetched cross-origin by tools and crawlers — the same
# rationale the marketplace Worker's _headers states for its own machine routes.
# Until 2026-08-07 the ONLY CORS rule here was the NIP-05 one below, so every .md
# twin, llms.txt, agents.txt and llms-full.txt were unreadable from a browser-
# resident agent while their marketplace equivalents were fine.
/llms.txt
  Access-Control-Allow-Origin: *
/llms-full.txt
  Access-Control-Allow-Origin: *
/agents.txt
  Access-Control-Allow-Origin: *
/sitemap-0.xml
  Access-Control-Allow-Origin: *
# sitemap-index.xml is the one llms.txt actually advertises; sitemap-0.xml is the
# shard nothing points at. Both listed so the advertised route is the working one.
/sitemap-index.xml
  Access-Control-Allow-Origin: *
/robots.txt
  Access-Control-Allow-Origin: *
# `/*.md` already matches NESTED paths — /tools/lnbits.md, /services/routstr.md and
# the rest. Cloudflare applies EVERY matching rule cumulatively, so the per-section
# blocks that used to sit here (/tools/*.md, /services/*.md, /exchanges/*.md,
# /skills/*.md) each added a SECOND `Access-Control-Allow-Origin: *`, and the two
# concatenated to `*, *` — not a valid origin. All 64 card .md routes failed
# cross-origin fetch with a hard TypeError, i.e. worse than the missing header this
# block was added to fix, while the root-level .md twins were fine. Removed
# 2026-08-08; they set no header `/*.md` does not already set.
/*.md
  Access-Control-Allow-Origin: *
