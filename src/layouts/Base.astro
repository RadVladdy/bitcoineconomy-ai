---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../lib/site';

interface Props {
  title: string;
  description?: string;
  current?: string;
  canonical?: string; // path, e.g. /thesis
  jsonLd?: object | object[];
  wide?: boolean;
  mdAlternate?: boolean; // false on pages that have no .md route (index pages)
}
const { title, description, current = '', canonical, jsonLd, wide = false, mdAlternate = true } = Astro.props;
const canonicalUrl = canonical ? new URL(canonical, SITE.url).href : new URL(Astro.url.pathname, SITE.url).href;
// The .md alternate is emitted ONLY when a .md route actually exists.
// Two guards, because the failure modes differ in severity:
//   • the root path guard is structural. Stripping the trailing slash from
//     "https://bitcoineconomy.ai/" yields "https://bitcoineconomy.ai", so
//     appending ".md" produced "https://bitcoineconomy.ai.md" — a DIFFERENT
//     DOMAIN. ai.md is Moldova's ccTLD and is registered and resolving, so the
//     homepage was advertising its machine-readable twin on a host under a third
//     party's DNS control. Never let string concatenation cross a domain boundary.
//   • mdAlternate={false} is the opt-out for index pages (/tools, /skills,
//     /for-agents), which are HTML-only — llms.txt says so — and whose alternates
//     404'd. Opt-OUT rather than opt-in so card and surface pages, which all do
//     have .md routes, cannot silently lose theirs.
const mdPathname = new URL(canonicalUrl).pathname.replace(/\/$/, '');
const mdHref = mdAlternate && mdPathname !== '' ? canonicalUrl.replace(/\/$/, '') + '.md' : null;
const fullTitle = title === SITE.name ? title : `${title} — ${SITE.shortName}`;
const ld = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <link rel="icon" type="image/png" sizes="32x32" href="/images/favicon-32.png" />
    <link rel="apple-touch-icon" href="/images/apple-touch.png" />
    <meta name="theme-color" content="#0e0e0e" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Space+Grotesk:wght@400;500;600;700&display=swap" />
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonicalUrl} />
    <meta name="generator" content={Astro.generator} />
    <meta property="og:type" content="article" />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:image" content={new URL('/images/og-default.png', SITE.url).href} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={new URL('/images/og-default.png', SITE.url).href} />
    <meta name="lightning" content="hello@bitcoineconomy.ai" />
    {mdHref && <link rel="alternate" type="text/markdown" href={mdHref} />}
    {ld.map((obj) => (
      <script type="application/ld+json" set:html={JSON.stringify(obj)} />
    ))}
      <!-- Cloudflare Web Analytics - cookieless, no personal data.
         Hard-wired because the zone's auto-install does not reach
         Pages-served responses, so the beacon never actually landed. -->
    <script is:inline defer src="https://static.cloudflareinsights.com/beacon.min.js"
      data-cf-beacon='{"token": "ddc6f7e3a204485b955eff70b8485dcb"}'></script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Nav current={current} />
    <main id="main" class={wide ? 'wide' : ''}>
      <slot />
    </main>
    <Footer />
  </body>
</html>
