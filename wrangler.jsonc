{
  "name": "bitcoineconomy-ai",
  "compatibility_date": "2026-06-01",
  "main": "src/worker.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  // Custom Domain — the hostname binding lives HERE as well as in Cloudflare, so
  // the repo describes the whole deployed thing rather than half of it. All three
  // Workers use this same shape (declared 2026-08-05; the bindings themselves are
  // older, they were simply never written down). The marketplace Worker declares
  // its own in marketplace-site/wrangler.jsonc.
  "routes": [
    { "pattern": "bitcoineconomy.ai", "custom_domain": true }
  ]
}
